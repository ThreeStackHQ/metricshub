# Database
DATABASE_URL=postgresql://user:password@localhost:5432/metricshub

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth
AUTH_SECRET=your-secret-key-here-min-32-chars-change-in-production

# Stripe (MetricsHub billing — for subscriptions to MetricsHub Pro)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO=price_...

# Stripe Connect (for connecting users' own Stripe accounts)
STRIPE_CONNECT_CLIENT_ID=ca_...

# Encryption key for Stripe access tokens (AES-256-GCM, 32 bytes hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Resend (Email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@metricshub.threestack.io
